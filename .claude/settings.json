{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.github/skills/orient/scripts/session_context.sh 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Gathering orientation data..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.github/skills/journal/scripts/compaction_reminder.sh post 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.github/skills/journal/scripts/compaction_reminder.sh pre 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
